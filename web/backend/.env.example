# Copy to /opt/ovbuilder/web/.env and fill in real values.
# Never commit the real .env.

# --- App ----------------------------------------------------------------
APP_NAME="OpenVox OV Builder"
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS='["https://builder.example.com"]'

# --- LDAP (OpenLDAP, bind-search-bind) ----------------------------------
LDAP_ENABLED=true
# Prefer ldaps:// in production. ldap_ssl_verify defaults to true.
LDAP_SERVER_URL=ldaps://ldap.example.com:636
LDAP_BIND_DN=cn=ovbuilder-svc,ou=services,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=ou=people,dc=example,dc=com
LDAP_USER_SEARCH_FILTER=(uid={username})
LDAP_USER_ATTR_USERNAME=uid
LDAP_USER_ATTR_EMAIL=mail
LDAP_USER_ATTR_DISPLAY_NAME=cn
LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=com
LDAP_GROUP_SEARCH_FILTER=(objectClass=groupOfNames)
LDAP_GROUP_MEMBER_ATTR=member
LDAP_GROUP_ATTR_NAME=cn
LDAP_ADMIN_GROUP=ovbuilder-admins
LDAP_BUILDER_GROUP=ovbuilder-builders
LDAP_VIEWER_GROUP=ovbuilder-viewers
LDAP_DEFAULT_ROLE=viewer
LDAP_USE_SSL=true
LDAP_USE_STARTTLS=false
LDAP_SSL_VERIFY=true
LDAP_CONNECTION_TIMEOUT=10

# --- Celery / Redis (local) ---------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- Postgres (local) ---------------------------------------------------
DATABASE_URL=postgresql+asyncpg://ovbuilder:ovbuilder@127.0.0.1:5432/ovbuilder

# --- ovbuilder CLI ------------------------------------------------------
OVBUILDER_BINARY=ovbuilder
OVBUILDER_HOME=/opt/ovbuilder
MAX_CONCURRENT_BUILDS=4
BUILD_TIME_LIMIT_SECONDS=3600
