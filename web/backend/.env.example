# Copy to /opt/ovbuilder/web/backend/.env and fill in real values.
# Never commit the real .env. install-web.sh seeds this file and generates
# a strong SECRET_KEY when the key is empty.

# --- App ----------------------------------------------------------------
APP_NAME="OpenVox OV Builder"
# DEBUG=true is the only way to boot without SECRET_KEY (ephemeral JWT key).
DEBUG=false
# Required unless DEBUG=true. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty / "change-me-in-production" are rejected by the API outside debug
# and by install-web.sh (the installer generates a strong key when empty).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# How often to re-read LDAP groups for an already-authenticated user.
# Local role overrides apply immediately and ignore this TTL. 0 = every request.
ROLE_CACHE_TTL_SECONDS=60

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS='["https://builder.example.com"]'

# --- LDAP (OpenLDAP, bind-search-bind) ----------------------------------
LDAP_ENABLED=true
# Prefer ldaps:// in production. LDAP_SSL_VERIFY defaults to true.
# For ldap:// + STARTTLS set LDAP_USE_STARTTLS=true (the backend calls start_tls()).
# Private CA: point LDAP_CA_CERTS_FILE at a PEM bundle the process can read.
LDAP_SERVER_URL=ldaps://ldap.example.com:636
LDAP_BIND_DN=cn=ovbuilder-svc,ou=services,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=ou=people,dc=example,dc=com
LDAP_USER_SEARCH_FILTER=(uid={username})
LDAP_USER_ATTR_USERNAME=uid
LDAP_USER_ATTR_EMAIL=mail
LDAP_USER_ATTR_DISPLAY_NAME=cn
LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=com
LDAP_GROUP_SEARCH_FILTER=(objectClass=groupOfNames)
LDAP_GROUP_MEMBER_ATTR=member
LDAP_GROUP_ATTR_NAME=cn
LDAP_ADMIN_GROUP=ovbuilder-admins
LDAP_BUILDER_GROUP=ovbuilder-builders
LDAP_VIEWER_GROUP=ovbuilder-viewers
LDAP_DEFAULT_ROLE=viewer
LDAP_USE_SSL=true
LDAP_USE_STARTTLS=false
# false is an explicit insecure lab opt-in; default is true.
LDAP_SSL_VERIFY=true
# PEM file for a private LDAP CA (used when LDAP_SSL_VERIFY=true).
# LDAP_CA_CERTS_FILE=/etc/pki/tls/certs/example-ldap-ca.pem
LDAP_CONNECTION_TIMEOUT=10

# --- Celery / Redis (local) ---------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- Postgres (local) ---------------------------------------------------
# Async SQLAlchemy URL. The API uses asyncpg; Celery workers and Alembic
# automatically use postgresql+psycopg:// with the same credentials.
# Apply schema:  cd /opt/ovbuilder/web/backend && alembic upgrade head
DATABASE_URL=postgresql+asyncpg://ovbuilder:ovbuilder@127.0.0.1:5432/ovbuilder

# --- ovbuilder CLI ------------------------------------------------------
OVBUILDER_BINARY=ovbuilder
OVBUILDER_HOME=/opt/ovbuilder
MAX_CONCURRENT_BUILDS=4
BUILD_TIME_LIMIT_SECONDS=3600

# --- vSphere (inventory + VM lifecycle; also settable in the admin UI) ---
# Required for live cluster/network/datastore-cluster lists on the Build form.
# Password is never returned by the API. Admin Settings can override these.
VSPHERE_SERVER=
VSPHERE_USER=
VSPHERE_PASSWORD=
VSPHERE_DATACENTER=
# Lab default. Set false when vCenter has a trusted certificate.
VSPHERE_IGNORE_SSL=true
# Optional alias the worker also honors:
# OVBUILDER_VSPHERE_PASSWORD=
#
# Environment → Storage DRS cluster (single source of truth is config.yaml
# `environments:`; these overlay that mapping without editing YAML):
# OVBUILDER_ENV_DEV_DATASTORE_CLUSTER=YAVIN-DEV
# OVBUILDER_ENV_PROD_DATASTORE_CLUSTER=YAVIN-PROD
# OVBUILDER_ENV_DEV_CLUSTER=
# OVBUILDER_ENV_PROD_CLUSTER=
