#cloud-config
# Ubuntu 24.04 autoinstall — ovbuilder golden (NO DHCP)
# Templated by Packer: ssh_password + ssh_password_crypted from local pkrvars
# (never commit real values). Generate crypted: openssl passwd -6 'your-password'
#
# The ubuntu user is created with the operator-supplied password only.
# Do not bake a well-known default password into this seed.
# Root is locked. sudo requires the operator password (no NOPASSWD).
# Packer uses communicator = "none"; it does not SSH during the golden build.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: ovbuilder-ubuntu-build
    username: ubuntu
    password: "${ssh_password_crypted}"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  network:
    network:
      version: 2
      ethernets:
        any:
          match:
            name: "e*"
          dhcp4: false
          optional: true
  packages:
    - open-vm-tools
    - cloud-init
    - cloud-guest-utils
    - curl
  user-data:
    disable_root: true
    package_update: false
    package_upgrade: false
    users:
      - name: ubuntu
        groups: [sudo]
        shell: /bin/bash
        lock_passwd: false
  late-commands:
    # Re-apply the operator password from pkrvars so console/SSH login works
    # if autoinstall identity hashing is ignored. Never use a baked-in default.
    - curtin in-target --target=/target -- bash -c "echo 'ubuntu:${ssh_password}' | chpasswd"
    - curtin in-target --target=/target -- passwd -l root || true
    - curtin in-target --target=/target -- systemctl enable open-vm-tools.service || true
    - curtin in-target --target=/target -- systemctl enable ssh.service || true
    - curtin in-target --target=/target -- systemctl enable cloud-init.service cloud-init-local.service cloud-config.service cloud-final.service || true
    - |
      cat > /target/etc/cloud/cloud.cfg.d/99-ovbuilder-vmware.cfg <<'EOF'
      datasource_list: [ VMware, OVF, None ]
      datasource:
        VMware:
          allow_raw_data: true
      EOF
    - curtin in-target --target=/target -- cloud-init clean --logs || true
    - truncate -s 0 /target/etc/machine-id || true
    - rm -f /target/var/lib/dbus/machine-id || true
    - ln -sf /etc/machine-id /target/var/lib/dbus/machine-id || true
    - rm -f /target/etc/ssh/ssh_host_* || true
    - rm -f /target/etc/netplan/*.yaml || true
  shutdown: poweroff
