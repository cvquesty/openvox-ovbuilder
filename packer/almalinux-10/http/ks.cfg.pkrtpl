# AlmaLinux 10 kickstart — minimal core golden (NO DHCP)
# Templated by Packer (ssh_password from variables.auto.pkrvars.hcl — not in git).
#
# Package set: @core + Tools/cloud-init. Packer waits for poweroff after %post.
# Clone identity (hostname / static IP) comes from ovbuilder guestinfo later.

text
cdrom
lang en_US.UTF-8
keyboard us
timezone UTC --utc

# AlmaLinux 10: network hostname only; clones get real addressing later.
network --hostname=localhost.localdomain
firewall --disabled
selinux --permissive
services --enabled="sshd,chronyd"

ignoredisk --only-use=sda
clearpart --all --initlabel --drives=sda
autopart --type=plain

rootpw --plaintext ${ssh_password}
user --name=almalinux --groups=wheel --password=${ssh_password} --plaintext

bootloader --location=mbr --boot-drive=sda
poweroff

%packages --ignoremissing --excludedocs
@core
open-vm-tools
cloud-init
cloud-utils-growpart
sudo
curl
tar
-gnome-*
-plasma-*
-libreoffice*
-kernel-debug*
%end

%post --log=/root/ks-post.log
set +e

echo 'almalinux ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/almalinux
chmod 440 /etc/sudoers.d/almalinux

systemctl enable sshd.service chronyd.service 2>/dev/null
systemctl enable vmtoolsd.service 2>/dev/null
systemctl enable open-vm-tools.service 2>/dev/null
systemctl enable cloud-init.service cloud-init-local.service cloud-config.service cloud-final.service 2>/dev/null

mkdir -p /etc/cloud/cloud.cfg.d
cat >/etc/cloud/cloud.cfg.d/99-ovbuilder-vmware.cfg <<'EOF'
datasource_list: [ VMware, OVF, None ]
datasource:
  VMware:
    allow_raw_data: true
EOF

if command -v cloud-init >/dev/null 2>&1; then
  cloud-init clean --logs --seed 2>/dev/null || cloud-init clean --logs 2>/dev/null || true
fi
truncate -s 0 /etc/machine-id 2>/dev/null || true
rm -f /var/lib/dbus/machine-id 2>/dev/null || true
ln -sf /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null || true
rm -f /etc/ssh/ssh_host_* 2>/dev/null || true
rm -f /etc/sysconfig/network-scripts/ifcfg-* 2>/dev/null || true
rm -f /etc/NetworkManager/system-connections/* 2>/dev/null || true
rm -rf /var/log/* /tmp/* /var/tmp/* 2>/dev/null || true
rm -f /root/.bash_history /home/*/.bash_history 2>/dev/null || true

sync
%end
