# Copy to variables.auto.pkrvars.hcl (gitignored) — NEVER commit the copy.
# See docs/SECRETS.md

vcenter_server   = "vcenter.example.com"
vcenter_username = "administrator@vsphere.local"
vcenter_password = "replace-me-not-in-git"

datacenter = "Main DC"
cluster    = "Production Cluster"
datastore  = "vsanDatastore"
network    = "VM Network"
folder     = "Templates"

iso_datastore = "isos"
insecure_connection = true

# Golden guest login (same value you put in ~/.config/ovbuilder/secrets.env
# as OVBUILDER_GOLDEN_PASSWORD for clones).
ssh_password = "replace-me-not-in-git"

# Ubuntu autoinstall identity requires a crypt hash of the same password:
#   openssl passwd -6 'replace-me-not-in-git'
ssh_password_crypted = "$6$rounds=5000$saltsalt$replace-with-openssl-passwd-6-output"

# Optional:
# ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
